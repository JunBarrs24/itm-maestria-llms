# Copia este archivo como .env y pon tu llave individual. El archivo .env no se versiona.
OPENAI_API_KEY=sk-...
# Modelo y esfuerzo de razonamiento (ver semana 4 y 5): none | minimal | low | medium | high | xhigh
OPENAI_MODEL=gpt-5-mini
REASONING_EFFORT=minimal
# Resumen del razonamiento en el panel: auto | concise | detailed. Vacío para no pedirlo.
REASONING_SUMMARY=auto
# Estrategia C: cómo se resume lo que sale de la ventana. determinista (gratis, tosco) | llm (una llamada más, conserva mejor)
COMPRESOR=llm
# Cada cuántos mensajes del historial se (re)comprime
UMBRAL_COMPRESION=8
